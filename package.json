{
  "name": "gtfs-hub",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check": "eslint . && tsc --noEmit && next build",
    "start": "next start",
    "lint": "eslint .",
    "bootstrap": "node scripts/run-project.mjs",
    "bootstrap:setup": "node scripts/run-project.mjs --setup-only",
    "deploy:local": "docker compose --env-file deploy.env -f compose.production.yml up --build -d",
    "deploy:down": "docker compose --env-file deploy.env -f compose.production.yml down"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "leaflet": "^1.9.4",
    "next": "^16.3.2",
    "pg": "^8.13.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.3.2",
    "typescript": "^5.7.2"
  }
}
